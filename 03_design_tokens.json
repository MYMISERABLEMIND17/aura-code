{
  "design_system_name": "AuraCode Raycast Design System",
  "theme": "dark",
  "brand_reference": "raycast",
  "color_palette": {
    "primary": {
      "h": 0,
      "s": "0%",
      "l": "100%",
      "hex": "#ffffff"
    },
    "background": {
      "h": 220,
      "s": "14%",
      "l": "3%",
      "hex": "#07080a"
    },
    "surface": {
      "h": 0,
      "s": "0%",
      "l": "6%",
      "hex": "#0f0f10"
    },
    "surface_elevated": {
      "h": 0,
      "s": "0%",
      "l": "11%",
      "hex": "#1c1c1e"
    },
    "border": {
      "h": 210,
      "s": "6%",
      "l": "16%",
      "hex": "#26282c"
    },
    "focus_ring": {
      "h": 210,
      "s": "100%",
      "l": "60%",
      "hex": "#2997ff"
    },
    "text_primary": {
      "h": 240,
      "s": "15%",
      "l": "96%",
      "hex": "#f4f4f6"
    },
    "text_muted": {
      "h": 240,
      "s": "5%",
      "l": "68%",
      "hex": "#b0b0b2"
    },
    "accent_success": {
      "h": 150,
      "s": "65%",
      "l": "44%",
      "hex": "#27ae60"
    },
    "accent_error": {
      "h": 0,
      "s": "100%",
      "l": "69%",
      "hex": "#ff6161"
    },
    "accent_error_surface": {
      "h": 0,
      "s": "50%",
      "l": "12%",
      "hex": "#2c1515"
    },
    "accent_warning": {
      "h": 44,
      "s": "100%",
      "l": "59%",
      "hex": "#ffc533"
    }
  },
  "opacity": {
    "loading": "0.6",
    "disabled": "0.4",
    "empty": "0.3"
  },
  "transitions": {
    "duration": {
      "fast": "100ms",
      "normal": "200ms",
      "slow": "350ms"
    },
    "easing": {
      "ease_out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "typography": {
    "font_family_sans": "Inter, -apple-system, sans-serif",
    "font_family_mono": "JetBrains Mono, monospace",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    }
  },
  "spacing_scale_px": [
    0,
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "border_radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "10px",
    "full": "9999px"
  },
  "components": [
    {
      "name": "Button",
      "states": {
        "default": {
          "background": "surface_elevated",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "border",
          "transition": "background-color 200ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms cubic-bezier(0.16, 1, 0.3, 1), border-color 200ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "hover": {
          "background": "surface",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "text_muted",
          "transform": "scale(1.02)",
          "transition": "background-color 100ms cubic-bezier(0.16, 1, 0.3, 1), border-color 100ms cubic-bezier(0.16, 1, 0.3, 1), transform 100ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "focus": {
          "box-shadow": "0 0 0 2px focus_ring",
          "background": "surface_elevated",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "border",
          "transition": "box-shadow 100ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "active": {
          "transform": "translateY(1px)",
          "opacity": "0.9",
          "background": "surface_elevated",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "border",
          "transition": "transform 100ms cubic-bezier(0.16, 1, 0.3, 1), opacity 100ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "loading": {
          "pointer-events": "none",
          "opacity": "0.6",
          "background": "surface_elevated",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "border",
          "transition": "opacity 200ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "disabled": {
          "opacity": "0.4",
          "pointer-events": "none",
          "background": "surface",
          "color": "text_muted",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "border",
          "transition": "opacity 200ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "error": {
          "background": "accent_error_surface",
          "color": "primary",
          "border-width": "1px",
          "border-style": "solid",
          "border-color": "accent_error",
          "transition": "background-color 200ms cubic-bezier(0.16, 1, 0.3, 1), border-color 200ms cubic-bezier(0.16, 1, 0.3, 1)"
        }
      }
    },
