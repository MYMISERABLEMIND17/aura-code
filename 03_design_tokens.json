          "border-width": "1px",
          "border-style": "solid",
          "border-color": "text_muted",
          "transition": "background-color 100ms cubic-bezier(0.16, 1, 0.3, 1), border-color 100ms cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "focus": {
