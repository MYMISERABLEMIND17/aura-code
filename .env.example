# AuraCode Environment Variables Template
# Copy this file to .env and replace with your actual values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auracode
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace_with_a_secure_random_secret_in_production
GITHUB_TOKEN=optional_github_token_for_extended_api_rate_limits
AWS_REGION=us-east-1
